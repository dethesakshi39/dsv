# Import Libraries
import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd

# 1. Read CSV File
df = pd.read_csv(r"C:\Users\Student\Downloads\train.csv")
print(df.head())

# 2. Display Dataset Information
print(df.info())

# 3. Display Statistical Description
print(df.describe())

# 4. Countplot of Survived
sns.countplot(x='Survived', data=df)
plt.title('Survival Distribution')
plt.xlabel('Survived')
plt.ylabel('Count')
plt.show()

# 5. Countplot of Passenger Class
sns.countplot(x='Pclass', data=df)
plt.title('Passenger Class Distribution')
plt.xlabel('Pclass')
plt.ylabel('Count')
plt.show()

# 6. Histogram of Age
sns.histplot(df['Age'].dropna(), bins=30, kde=True)
plt.title('Age Distribution')
plt.xlabel('Age')
plt.ylabel('Frequency')
plt.show()

# 7. Survival Rate by Gender
sns.barplot(x='Sex', y='Survived', data=df)
plt.title('Survival Rate by Gender')
plt.xlabel('Sex')
plt.ylabel('Survival Rate')
plt.show()

# 8. Survival Rate by Passenger Class
sns.barplot(x='Pclass', y='Survived', data=df)
plt.title('Survival Rate by Passenger Class')
plt.xlabel('Pclass')
plt.ylabel('Survival Rate')
plt.show()

# 9. Survival Rate by Embarked
sns.barplot(x='Embarked', y='Survived', data=df)
plt.title('Survival Rate by Embarked')
plt.xlabel('Embarked')
plt.ylabel('Survival Rate')
plt.show()

# 10. Boxplot of Fare vs Survival
sns.boxplot(x='Survived', y='Fare', data=df)
plt.title('Fare vs. Survival')
plt.xlabel('Survived')
plt.ylabel('Fare')
plt.show()

# 11. Scatterplot of Age and Fare
sns.scatterplot(x='Age', y='Fare', hue='Survived',
                style='Pclass', data=df)
plt.title('Survival Rate by Age and Passenger Class')
plt.xlabel('Age')
plt.ylabel('Fare')
plt.show()

# 12. Pairplot of Selected Features
sns.pairplot(df[['Age', 'Fare', 'Pclass', 'Survived']].dropna(),
             hue='Survived')
plt.title('Pairplot of Selected Features')
plt.show()
